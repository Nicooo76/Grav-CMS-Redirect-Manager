{#
    Page for a rule with status 410. To change it, copy this file to
    user/themes/<your-theme>/templates/redirect-manager/gone.html.twig: a theme template wins over this one.

    Variables:
      redirect_status  int     410
      redirect_path    string  the requested path as the rules see it: no query string, no base path, no language prefix
    plus Grav's own: site, config, base_url, home_url, html_lang, and the |t filter. Nothing else is passed in.
    The response carries "X-Robots-Tag: noindex" and "X-Redirect-By: Grav Redirect Manager" whatever the template says.
#}
<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'PLUGIN_REDIRECT_MANAGER.FRONTEND.GONE_TITLE'|t }}{% if site.title %} | {{ site.title }}{% endif %}</title>
    <style>
        :root { color-scheme: light dark; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 16px/1.5 system-ui, sans-serif; background: Canvas; color: CanvasText; }
        main { max-width: 32rem; padding: 2rem 1.5rem; }
        p.code { margin: 0 0 .5rem; font-size: .875rem; letter-spacing: .08em; opacity: .6; }
        h1 { margin: 0 0 1rem; font-size: 1.75rem; line-height: 1.2; }
        a { color: LinkText; }
    </style>
</head>
<body>
    <main>
        <p class="code">{{ redirect_status|default(410) }}</p>
        <h1>{{ 'PLUGIN_REDIRECT_MANAGER.FRONTEND.GONE_TITLE'|t }}</h1>
        <p>{{ 'PLUGIN_REDIRECT_MANAGER.FRONTEND.GONE_TEXT'|t }}</p>
        <p><a href="{{ home_url|default('/') }}">{{ 'PLUGIN_REDIRECT_MANAGER.FRONTEND.HOME_LINK'|t }}</a></p>
    </main>
</body>
</html>
