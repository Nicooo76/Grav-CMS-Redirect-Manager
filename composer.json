{
    "name": "pixagentur/grav-plugin-redirect-manager",
    "type": "grav-plugin",
    "description": "Redirect Manager for Grav 2: exact, wildcard and regex redirects, 404 monitor, suggestions, auto-redirects, import/export, CLI, REST API and Admin 2 UI.",
    "keywords": [
        "grav",
        "plugin",
        "redirect",
        "301",
        "404",
        "seo"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "PixAgentur",
            "homepage": "https://pixagentur.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "symfony/yaml": "^7.0",
        "symfony/http-client": "^7.0"
    },
    "suggest": {
        "ext-intl": "Unicode normalization of request paths (NFC)",
        "ext-pdo_sqlite": "Optional SQLite backend for the 404 log"
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\RedirectManager\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grav\\Plugin\\RedirectManager\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "unit": "phpunit --testsuite unit",
        "integration": "phpunit --testsuite integration",
        "coverage": "php -d pcov.enabled=1 vendor/bin/phpunit --testsuite unit --coverage-text --coverage-clover=build/clover.xml",
        "test": [
            "@cs",
            "@stan",
            "@unit"
        ]
    }
}
